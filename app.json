{
  "expo": {
    "name": "Muslim Deen: Quran & Prayer",
    "slug": "wedeen",
    "scheme": "wedeen",
    "version": "1.0.3",
    "orientation": "default",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F5EF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F5EF"
      },
      "package": "com.hussnainahmadsahi.wedeen",
      "versionCode": 4,
      "backgroundColor": "#F8F5EF",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F5EF"
        }
      ],
      "expo-router",
      "./plugins/withWedeenPrayerWidgetAndroid.js",
      "./plugins/withWedeenPrayerLock.js",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/adhan.m4a"
          ]
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow Muslim Deen: Quran & Prayer to use your location to keep prayer times and the adhan accurate while you travel.",
          "locationWhenInUsePermission": "Allow Muslim Deen: Quran & Prayer to use your location to calculate accurate prayer times for your area."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c338265b-6aad-4f74-85af-2871fa5c2509"
      }
    },
    "owner": "hussnainahmadsahi"
  }
}
