{
  "expo": {
    "name": "WeDeen",
    "slug": "wedeen",
    "scheme": "wedeen",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F5EF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F5EF"
      },
      "package": "com.hussnainahmadsahi.wedeen",
      "versionCode": 2,
      "backgroundColor": "#F6F1E7",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-app-blocker",
        {
          "android": {
            "scheme": "wedeen",
            "overlayTitle": "WeDeen",
            "overlayText": "Salah is calling…",
            "overlayBackgroundColor": "#0F3D2E",
            "overlayTitleColor": "#FFFFFF",
            "overlayTextColor": "rgba(255,255,255,0.88)",
            "overlay": {
              "icon": "./assets/images/logo.png"
            }
          }
        }
      ],
      "./plugins/withWedeenPrayerLockAndroid.js",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/adhan.m4a"
          ]
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow WeDeen to use your location to keep prayer times and the adhan accurate while you travel.",
          "locationWhenInUsePermission": "Allow WeDeen to use your location to calculate accurate prayer times for your area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c338265b-6aad-4f74-85af-2871fa5c2509"
      }
    },
    "owner": "hussnainahmadsahi"
  }
}
